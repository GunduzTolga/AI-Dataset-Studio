<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AIDatasetStudio.Desktop.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AIDatasetStudio/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#4F46E5" RegionColor="#FFFFFF" ErrorText="#B91C1C" />
        <ColorPaletteResources x:Key="Dark" Accent="#6366F1" RegionColor="#18181B" ErrorText="#FCA5A5" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- The record editor's highlighting text fields (AvaloniaEdit), restyled in Controls.axaml. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://AIDatasetStudio/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
