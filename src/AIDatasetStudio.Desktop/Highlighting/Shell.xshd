<?xml version="1.0" encoding="utf-8"?>
<!-- Bash, sh, zsh and PowerShell commands. -->
<SyntaxDefinition name="Shell" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" fontStyle="italic" />
  <Color name="String" />
  <Color name="Keyword" />
  <Color name="Variable" />
  <Color name="Attribute" />
  <RuleSet>
    <Span color="Comment" begin="(?&lt;![\w$&lt;])#" />
    <Span color="String" begin="&quot;" end="&quot;">
      <RuleSet>
        <Span begin="\\" end="." />
        <Rule color="Variable">\$\{[^}]*\}|\$[A-Za-z_]\w*</Rule>
      </RuleSet>
    </Span>
    <Span color="String" begin="'" end="'" />
    <Rule color="Variable">\$\{[^}]*\}|\$[A-Za-z_]\w*|\$[?\#@*$!0-9-]</Rule>
    <Rule color="Attribute">(?&lt;=[ \t])--?[A-Za-z][\w-]*</Rule>
    <Keywords color="Keyword">
      <Word>alias</Word><Word>case</Word><Word>cd</Word><Word>declare</Word><Word>do</Word><Word>done</Word>
      <Word>echo</Word><Word>elif</Word><Word>else</Word><Word>esac</Word><Word>exit</Word><Word>export</Word>
      <Word>fi</Word><Word>for</Word><Word>function</Word><Word>if</Word><Word>in</Word><Word>local</Word>
      <Word>readonly</Word><Word>return</Word><Word>set</Word><Word>source</Word><Word>sudo</Word><Word>then</Word>
      <Word>unset</Word><Word>until</Word><Word>while</Word>
    </Keywords>
  </RuleSet>
</SyntaxDefinition>
