<!--
  Design tokens of AI Dataset Studio (see docs/design-system.md).
  Components never use raw colors; they reference these semantic brushes, which are defined
  once per theme variant. All text/background pairs meet WCAG AA (4.5:1).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Surfaces -->
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F6F7" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="InspectorBackgroundBrush" Color="#FAFAFB" />
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F0F3" />
      <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E7E7EB" />
      <SolidColorBrush x:Key="SubtleFillBrush" Color="#F4F4F5" />
      <SolidColorBrush x:Key="BorderBrush" Color="#E6E6EA" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#D4D4DA" />

      <!-- Text -->
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18181B" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#52525B" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#63636B" />
      <SolidColorBrush x:Key="TextDisabledBrush" Color="#A1A1AA" />

      <!-- Accent (indigo) -->
      <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#3730A3" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EEF0FF" />
      <SolidColorBrush x:Key="AccentSubtleHoverBrush" Color="#E3E6FF" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#4338CA" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

      <!-- Danger -->
      <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
      <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />
      <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FEE2E2" />
      <SolidColorBrush x:Key="DangerTextBrush" Color="#B91C1C" />
      <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FEF3C7" />
      <SolidColorBrush x:Key="WarningTextBrush" Color="#92400E" />

      <!-- Record status -->
      <SolidColorBrush x:Key="StatusDraftBackgroundBrush" Color="#F1F1F3" />
      <SolidColorBrush x:Key="StatusDraftForegroundBrush" Color="#3F3F46" />
      <SolidColorBrush x:Key="StatusReviewBackgroundBrush" Color="#FEF3C7" />
      <SolidColorBrush x:Key="StatusReviewForegroundBrush" Color="#92400E" />
      <SolidColorBrush x:Key="StatusApprovedBackgroundBrush" Color="#D1FAE5" />
      <SolidColorBrush x:Key="StatusApprovedForegroundBrush" Color="#065F46" />
      <SolidColorBrush x:Key="StatusArchivedBackgroundBrush" Color="#FFE4E6" />
      <SolidColorBrush x:Key="StatusArchivedForegroundBrush" Color="#9F1239" />

      <!-- Content tones (preference pairs, chat) -->
      <SolidColorBrush x:Key="PositiveBrush" Color="#059669" />
      <SolidColorBrush x:Key="NegativeBrush" Color="#E11D48" />
      <SolidColorBrush x:Key="UserBubbleBrush" Color="#EEF0FF" />
      <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#FFFFFF" />

      <!-- Version differences: text backgrounds behind primary text -->
      <SolidColorBrush x:Key="DiffInsertedBrush" Color="#BBF7D0" />
      <SolidColorBrush x:Key="DiffDeletedBrush" Color="#FECDD3" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121215" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#18181B" />
      <SolidColorBrush x:Key="InspectorBackgroundBrush" Color="#141417" />
      <SolidColorBrush x:Key="CardBrush" Color="#1D1D21" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#232328" />
      <SolidColorBrush x:Key="SurfacePressedBrush" Color="#2B2B31" />
      <SolidColorBrush x:Key="SubtleFillBrush" Color="#222226" />
      <SolidColorBrush x:Key="BorderBrush" Color="#2A2A30" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A3A42" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C4C4CC" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#9C9CA6" />
      <SolidColorBrush x:Key="TextDisabledBrush" Color="#5C5C66" />

      <SolidColorBrush x:Key="AccentBrush" Color="#5B54E8" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#6D67F0" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#4A43D6" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#25264A" />
      <SolidColorBrush x:Key="AccentSubtleHoverBrush" Color="#2E3058" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#A5B4FC" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

      <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
      <SolidColorBrush x:Key="DangerHoverBrush" Color="#EF4444" />
      <SolidColorBrush x:Key="DangerSubtleBrush" Color="#3F1720" />
      <SolidColorBrush x:Key="DangerTextBrush" Color="#FCA5A5" />
      <SolidColorBrush x:Key="WarningSubtleBrush" Color="#3A2C0F" />
      <SolidColorBrush x:Key="WarningTextBrush" Color="#FCD34D" />

      <SolidColorBrush x:Key="StatusDraftBackgroundBrush" Color="#27272A" />
      <SolidColorBrush x:Key="StatusDraftForegroundBrush" Color="#D4D4D8" />
      <SolidColorBrush x:Key="StatusReviewBackgroundBrush" Color="#3A2C0F" />
      <SolidColorBrush x:Key="StatusReviewForegroundBrush" Color="#FCD34D" />
      <SolidColorBrush x:Key="StatusApprovedBackgroundBrush" Color="#0E3A2C" />
      <SolidColorBrush x:Key="StatusApprovedForegroundBrush" Color="#6EE7B7" />
      <SolidColorBrush x:Key="StatusArchivedBackgroundBrush" Color="#3F1720" />
      <SolidColorBrush x:Key="StatusArchivedForegroundBrush" Color="#FDA4AF" />

      <SolidColorBrush x:Key="PositiveBrush" Color="#34D399" />
      <SolidColorBrush x:Key="NegativeBrush" Color="#FB7185" />
      <SolidColorBrush x:Key="UserBubbleBrush" Color="#25264A" />
      <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#1D1D21" />

      <SolidColorBrush x:Key="DiffInsertedBrush" Color="#1D5236" />
      <SolidColorBrush x:Key="DiffDeletedBrush" Color="#62202E" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Brand mark gradient (same in both themes) -->
  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#6366F1" />
    <GradientStop Offset="1" Color="#9333EA" />
  </LinearGradientBrush>

  <!-- Type scale (Inter) -->
  <x:Double x:Key="FontSizeCaption">11</x:Double>
  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeSubtitle">15</x:Double>
  <x:Double x:Key="FontSizeTitle">20</x:Double>
  <x:Double x:Key="FontSizeDisplay">28</x:Double>

  <!-- Radii -->
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">10</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Fluent theme overrides -->
  <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

  <!-- Monospace stack for hashes; numbers in lists use Inter's tabular figures instead. -->
  <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, JetBrains Mono, SF Mono, Menlo, Consolas, monospace</FontFamily>
</ResourceDictionary>
