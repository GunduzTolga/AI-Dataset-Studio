<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIDatasetStudio.Desktop.ViewModels"
             xmlns:l="using:AIDatasetStudio.Desktop.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:AIDatasetStudio.Desktop.Controls"
             xmlns:conv="using:AIDatasetStudio.Desktop.Converters"
             x:Class="AIDatasetStudio.Desktop.Views.RecordListView"
             x:DataType="vm:RecordListViewModel">
  <Panel>
    <!-- Nothing selected -->
    <StackPanel Classes="empty" IsVisible="{Binding !HasDataset}">
      <Border Classes="empty-icon">
        <ic:SymbolIcon Symbol="TextBulletListSquare" />
      </Border>
      <TextBlock Classes="subtitle" Text="{l:Tr Records_NoDatasetTitle}" />
      <TextBlock Classes="muted" Text="{l:Tr Records_NoDatasetHint}" />
    </StackPanel>

    <DockPanel IsVisible="{Binding HasDataset}">
      <!-- Dataset header -->
      <StackPanel DockPanel.Dock="Top" Margin="20,18,20,12" Spacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="{Binding Dataset.Type, Converter={x:Static conv:IconConverters.DatasetType}, FallbackValue=DocumentText}"
                           FontSize="20" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="title" Text="{Binding Dataset.Name, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
              <Border Classes="tag">
                <TextBlock Text="{Binding Dataset.TypeLabel, FallbackValue=''}" />
              </Border>
            </StackPanel>
            <TextBlock Classes="small muted" Text="{Binding Dataset.Subtitle, FallbackValue=''}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="subtle" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding !IsEmptyDataset}"
                  ToolTip.Tip="{l:Tr Action_ImportFromFile}"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="ArrowImport" />
              <TextBlock Text="{l:Tr Action_Import}" />
            </StackPanel>
          </Button>
        </Grid>

        <TextBox Classes="search clearButton" Text="{Binding SearchText}" PlaceholderText="{l:Tr Records_SearchWatermark}"
                 IsVisible="{Binding !IsEmptyDataset}">
          <TextBox.InnerLeftContent>
            <ic:SymbolIcon Symbol="Search" FontSize="16" Margin="10,0,4,0" Foreground="{DynamicResource TextMutedBrush}" />
          </TextBox.InnerLeftContent>
        </TextBox>

        <ListBox Classes="chips" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" SelectionMode="AlwaysSelected"
                 IsVisible="{Binding !IsEmptyDataset}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StatusFilterOption">
              <Border Classes="chip">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="small strong" Text="{Binding Label}" />
                  <TextBlock Classes="small muted numeric" Text="{Binding CountText}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <!-- Column headers -->
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1" Padding="16,6,20,6"
              Background="{DynamicResource AppBackgroundBrush}" IsVisible="{Binding !IsEmptyDataset}">
        <Grid ColumnDefinitions="64,116,*">
          <TextBlock Classes="overline" Text="#" />
          <TextBlock Grid.Column="1" Classes="overline" Text="{l:Tr Records_ColumnStatus}" />
          <TextBlock Grid.Column="2" Classes="overline" Text="{l:Tr Records_ColumnContent}" />
        </Grid>
      </Border>

      <Panel>
        <ListBox x:Name="RecordList" Classes="records" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecordRowViewModel">
              <Panel>
                <Border Classes="row">
                  <Grid ColumnDefinitions="64,116,*">
                    <TextBlock Classes="small muted numeric" Text="{Binding OrdinalText}" VerticalAlignment="Center" />
                    <controls:StatusBadge Grid.Column="1" Status="{Binding Status}" Text="{Binding StatusLabel}" />
                    <TextBlock Grid.Column="2" Text="{Binding Preview}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
                <Border Classes="row-indicator" />
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty list -->
        <StackPanel Classes="empty" IsVisible="{Binding IsEmptyDataset}">
          <Border Classes="empty-icon">
            <ic:SymbolIcon Symbol="DocumentText" />
          </Border>
          <TextBlock Classes="subtitle" Text="{l:Tr Records_EmptyTitle}" />
          <TextBlock Classes="muted" Text="{l:Tr Records_EmptyHint}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
            <Button Classes="accent"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="ArrowImport" />
                <TextBlock Text="{l:Tr Action_ImportFromFile}" />
              </StackPanel>
            </Button>
            <Button Classes="subtle"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GenerateSampleDataCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="Sparkle" />
                <TextBlock Text="{l:Tr Action_GenerateSamples}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
        <StackPanel Classes="empty" IsVisible="{Binding IsNoMatches}">
          <Border Classes="empty-icon">
            <ic:SymbolIcon Symbol="Search" />
          </Border>
          <TextBlock Classes="subtitle" Text="{l:Tr Records_NoMatchesTitle}" />
          <TextBlock Classes="muted" Text="{l:Tr Records_NoMatches}" />
        </StackPanel>
      </Panel>
    </DockPanel>
  </Panel>
</UserControl>
