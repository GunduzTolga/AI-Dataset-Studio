<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIDatasetStudio.Desktop.ViewModels"
             xmlns:l="using:AIDatasetStudio.Desktop.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:AIDatasetStudio.Desktop.Controls"
             xmlns:conv="using:AIDatasetStudio.Desktop.Converters"
             x:Class="AIDatasetStudio.Desktop.Views.RecordListView"
             x:DataType="vm:RecordListViewModel">
  <Panel>
    <!-- Nothing selected -->
    <StackPanel Classes="empty" IsVisible="{Binding !HasDataset}">
      <Border Classes="empty-icon">
        <ic:SymbolIcon Symbol="TextBulletListSquare" />
      </Border>
      <TextBlock Classes="subtitle" Text="{l:Tr Records_NoDatasetTitle}" />
      <TextBlock Classes="muted" Text="{l:Tr Records_NoDatasetHint}" />
    </StackPanel>

    <DockPanel IsVisible="{Binding HasDataset}">
      <!-- Dataset header -->
      <StackPanel DockPanel.Dock="Top" Margin="20,18,20,12" Spacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="{Binding Dataset.Type, Converter={x:Static conv:IconConverters.DatasetType}, FallbackValue=DocumentText}"
                           FontSize="20" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="title" Text="{Binding Dataset.Name, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
              <Border Classes="tag">
                <TextBlock Text="{Binding Dataset.TypeLabel, FallbackValue=''}" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="small muted" Text="{Binding Dataset.Subtitle, FallbackValue=''}" />
              <!-- Background analysis (tokens and quality) -->
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.IsAnalyzing}">
                <ProgressBar Width="60" Minimum="0" Maximum="1" VerticalAlignment="Center"
                             Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.ProgressValue}" />
                <TextBlock Classes="small muted" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.ProgressText}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding !IsEmptyDataset}">
            <Button Classes="subtle" ToolTip.Tip="{l:Tr Action_ImportFromFile}"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="ArrowImport" />
                <TextBlock Text="{l:Tr Action_Import}" />
              </StackPanel>
            </Button>
            <Button x:Name="ExportButton" Classes="subtle" ToolTip.Tip="{l:Tr Action_ExportToFile}"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="ArrowExport" />
                <TextBlock Text="{l:Tr Action_Export}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsEmptyDataset}">
          <TextBox x:Name="SearchBox" Classes="search clearButton" Text="{Binding SearchText}" PlaceholderText="{l:Tr Records_SearchWatermark}">
            <TextBox.InnerLeftContent>
              <ic:SymbolIcon Symbol="Search" FontSize="16" Margin="10,0,4,0" Foreground="{DynamicResource TextMutedBrush}" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="190" VerticalAlignment="Stretch"
                    ItemsSource="{Binding QualityFilters}" SelectedItem="{Binding SelectedQualityFilter}" ToolTip.Tip="{l:Tr Records_QualityFilter}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:QualityFilterOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <ListBox Classes="chips" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" SelectionMode="AlwaysSelected"
                 IsVisible="{Binding !IsEmptyDataset}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StatusFilterOption">
              <Border Classes="chip">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="small strong" Text="{Binding Label}" />
                  <TextBlock Classes="small muted numeric" Text="{Binding CountText}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <!-- Column headers -->
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1" Padding="16,6,20,6"
              Background="{DynamicResource AppBackgroundBrush}" IsVisible="{Binding !IsEmptyDataset}">
        <Grid ColumnDefinitions="64,116,*,76,64">
          <TextBlock Classes="overline" Text="#" />
          <TextBlock Grid.Column="1" Classes="overline" Text="{l:Tr Records_ColumnStatus}" />
          <TextBlock Grid.Column="2" Classes="overline" Text="{l:Tr Records_ColumnContent}" />
          <TextBlock Grid.Column="3" Classes="overline" Text="{l:Tr Records_ColumnTokens}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="4" Classes="overline" Text="{l:Tr Records_ColumnQuality}" HorizontalAlignment="Right" />
        </Grid>
      </Border>

      <Panel>
        <ListBox x:Name="RecordList" Classes="records" ItemsSource="{Binding Items}" Selection="{Binding Selection}" SelectionMode="Multiple">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecordRowViewModel">
              <Panel>
                <Border Classes="row">
                  <Grid ColumnDefinitions="64,116,*,76,64">
                    <TextBlock Classes="small muted numeric" Text="{Binding OrdinalText}" VerticalAlignment="Center" />
                    <controls:StatusBadge Grid.Column="1" Status="{Binding Status}" Text="{Binding StatusLabel}" />
                    <TextBlock Grid.Column="2" Text="{Binding Preview}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <ic:SymbolIcon Symbol="Flag" FontSize="12" Foreground="{DynamicResource DangerTextBrush}" IsVisible="{Binding IsOverContextLimit}"
                                     ToolTip.Tip="{l:Tr Records_OverContextLimit}" />
                      <TextBlock Classes="small numeric" Classes.muted="{Binding !IsOverContextLimit}" Classes.error="{Binding IsOverContextLimit}"
                                 Text="{Binding TokenText}" />
                    </StackPanel>
                    <Border Grid.Column="4" Classes="score" Classes.good="{Binding IsGood}" Classes.fair="{Binding IsFair}" Classes.poor="{Binding IsPoor}"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ScoreText}" />
                    </Border>
                  </Grid>
                </Border>
                <Border Classes="row-indicator" />
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty list -->
        <StackPanel Classes="empty" IsVisible="{Binding IsEmptyDataset}">
          <Border Classes="empty-icon">
            <ic:SymbolIcon Symbol="DocumentText" />
          </Border>
          <TextBlock Classes="subtitle" Text="{l:Tr Records_EmptyTitle}" />
          <TextBlock Classes="muted" Text="{l:Tr Records_EmptyHint}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
            <Button Classes="accent"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="ArrowImport" />
                <TextBlock Text="{l:Tr Action_ImportFromFile}" />
              </StackPanel>
            </Button>
            <Button Classes="subtle"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GenerateSampleDataCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="Sparkle" />
                <TextBlock Text="{l:Tr Action_GenerateSamples}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
        <StackPanel Classes="empty" IsVisible="{Binding IsNoMatches}">
          <Border Classes="empty-icon">
            <ic:SymbolIcon Symbol="Search" />
          </Border>
          <TextBlock Classes="subtitle" Text="{l:Tr Records_NoMatchesTitle}" />
          <TextBlock Classes="muted" Text="{l:Tr Records_NoMatches}" />
        </StackPanel>
      </Panel>
    </DockPanel>
  </Panel>
</UserControl>
