<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIDatasetStudio.Desktop.ViewModels"
             xmlns:l="using:AIDatasetStudio.Desktop.Localization"
             x:Class="AIDatasetStudio.Desktop.Views.RecordListView"
             x:DataType="vm:RecordListViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="paneHeader" Text="{l:Tr Pane_Records}" />

    <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
               Text="{l:Tr Records_Placeholder}" IsVisible="{Binding !HasDataset}" />

    <DockPanel IsVisible="{Binding HasDataset}">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,0,12,8">
        <TextBox Text="{Binding SearchText}" PlaceholderText="{l:Tr Records_SearchWatermark}" />
        <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="150"
                  ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StatusFilterOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="2" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding CountText}" />
      </Grid>

      <Panel>
        <ListBox x:Name="RecordList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecordRowViewModel">
              <Grid ColumnDefinitions="64,96,*">
                <TextBlock Classes="muted" Text="{Binding OrdinalText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Preview}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24"
                   Text="{Binding EmptyMessage}" IsVisible="{Binding EmptyMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Panel>
    </DockPanel>
  </DockPanel>
</UserControl>
