<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIDatasetStudio.Desktop.ViewModels"
             xmlns:tags="using:AIDatasetStudio.Desktop.ViewModels.Tags"
             xmlns:l="using:AIDatasetStudio.Desktop.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:AIDatasetStudio.Desktop.Controls"
             xmlns:conv="using:AIDatasetStudio.Desktop.Converters"
             xmlns:ai="using:AIDatasetStudio.Application.AI"
             x:Class="AIDatasetStudio.Desktop.Views.RecordDetailsView"
             x:DataType="vm:RecordDetailsViewModel">
  <UserControl.Styles>
    <Style Selector="WrapPanel.actions > Button">
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- A tag on the shown or selected records: dot, name and a button that takes it off -->
    <DataTemplate x:Key="TagChip" x:DataType="tags:TagViewModel">
      <Border Classes="tag-chip" Margin="0,0,6,6" ToolTip.Tip="{Binding ShortcutText}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center" />
          <TextBlock Classes="small" Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
          <Button Classes="mini" ToolTip.Tip="{l:Tr Editor_RemoveTag}" CommandParameter="{Binding}"
                  Command="{Binding $parent[UserControl].((vm:RecordDetailsViewModel)DataContext).RemoveTagCommand}">
            <ic:SymbolIcon Symbol="Dismiss" />
          </Button>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- "Add tag": filter or create -->
    <DataTemplate x:Key="TagPickerContent" x:DataType="tags:TagPickerViewModel">
      <Border Classes="popup" Width="280">
        <StackPanel Spacing="6">
          <TextBox Classes="tag-query" Text="{Binding Query}" PlaceholderText="{l:Tr TagPicker_Watermark}" MaxLength="100">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <ScrollViewer MaxHeight="240" IsVisible="{Binding HasMatches}">
            <ItemsControl ItemsSource="{Binding Matches}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="tags:TagViewModel">
                  <Button Classes="menu-item" CommandParameter="{Binding}"
                          Command="{Binding $parent[ItemsControl].((tags:TagPickerViewModel)DataContext).PickCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="small" Text="{Binding Name}" Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="caption muted" Text="{Binding ShortcutText}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Classes="menu-item" Command="{Binding CreateCommand}" IsVisible="{Binding CanCreate}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:SymbolIcon Symbol="Add" FontSize="14" />
              <TextBlock Classes="small" Text="{Binding CreateText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption muted" Text="{l:Tr TagPicker_Empty}" TextWrapping="Wrap" Margin="4,2" IsVisible="{Binding IsEmpty}" />
          <TextBlock Classes="caption muted" Text="{l:Tr TagPicker_Hint}" TextWrapping="Wrap" Margin="4,2,4,0" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Panel>
    <!-- One record: editor -->
    <DockPanel IsVisible="{Binding HasRecord}">
      <StackPanel DockPanel.Dock="Top" Margin="20,18,20,12" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="title numeric" Text="{Binding Title}" />
          <controls:StatusBadge Status="{Binding Status}" Text="{Binding StatusLabel}" VerticalAlignment="Center" />
          <!-- Live token count against the dataset's context length -->
          <Border Classes="score" Classes.good="{Binding IsTokenGood}" Classes.fair="{Binding IsTokenFair}" Classes.poor="{Binding IsTokenPoor}"
                  VerticalAlignment="Center" IsVisible="{Binding HasTokens}" ToolTip.Tip="{Binding TokenDetail}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ic:SymbolIcon Symbol="TextWordCount" />
              <TextBlock Classes="numeric" Text="{Binding TokenText}" />
            </StackPanel>
          </Border>
          <!-- Quality score; the issues are listed below the content -->
          <Border Classes="score" Classes.good="{Binding IsQualityGood}" Classes.fair="{Binding IsQualityFair}" Classes.poor="{Binding IsQualityPoor}"
                  VerticalAlignment="Center" IsVisible="{Binding HasTokens}" ToolTip.Tip="{l:Tr Details_QualityScore}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ic:SymbolIcon Symbol="HeartPulse" />
              <TextBlock Classes="numeric" Text="{Binding QualityScoreText}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <WrapPanel Classes="actions">
            <Button x:Name="ApproveButton" Classes="accent" Command="{Binding ApproveCommand}" IsVisible="{Binding ShowApprove}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="Checkmark" />
                <TextBlock Text="{l:Tr Action_Approve}" />
              </StackPanel>
            </Button>
            <Button Command="{Binding SendToReviewCommand}" IsVisible="{Binding ShowSendToReview}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="Eye" />
                <TextBlock Text="{l:Tr Action_SendToReview}" />
              </StackPanel>
            </Button>
            <Button x:Name="ArchiveButton" Command="{Binding ArchiveCommand}" IsVisible="{Binding ShowArchive}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="Archive" />
                <TextBlock Text="{l:Tr Action_Archive}" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Command="{Binding RestoreCommand}" IsVisible="{Binding ShowRestore}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="ArrowUndo" />
                <TextBlock Text="{l:Tr Action_Restore}" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
            <Button x:Name="CompareButton" Classes="icon" Classes.subtle="{Binding !IsPreferenceCompare}" Classes.accent="{Binding IsPreferenceCompare}"
                    Command="{Binding TogglePreferenceCompareCommand}" IsVisible="{Binding IsPreference}" ToolTip.Tip="{l:Tr Editor_PreferenceCompare}">
              <ic:SymbolIcon Symbol="ColumnDoubleCompare" />
            </Button>
            <Button x:Name="PiiButton" Classes="icon" Classes.subtle="{Binding !IsPiiPreview}" Classes.accent="{Binding IsPiiPreview}"
                    Command="{Binding TogglePiiPreviewCommand}" ToolTip.Tip="{l:Tr Editor_PiiPreview}">
              <ic:SymbolIcon Symbol="ShieldLock" />
            </Button>
            <Button x:Name="DeleteButton" Classes="danger-subtle icon" Command="{Binding DeleteCommand}" ToolTip.Tip="{l:Tr Action_Delete}">
              <ic:SymbolIcon Symbol="Delete" />
            </Button>
          </StackPanel>
        </Grid>
        <!-- Tags (SDD §6.2): Mod+1…5 toggles the tags with a shortcut -->
        <WrapPanel Margin="0,-6,0,-6">
          <ItemsControl x:Name="RecordTagList" ItemsSource="{Binding RecordTags}" ItemTemplate="{StaticResource TagChip}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Button x:Name="AddTagButton" Classes="subtle small" Margin="0,0,0,6" Command="{Binding OpenTagPickerCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <ic:SymbolIcon Symbol="TagAdd" FontSize="14" />
              <TextBlock Classes="small" Text="{l:Tr Editor_AddTag}" />
            </StackPanel>
          </Button>
          <Popup x:Name="TagPopup" IsOpen="{Binding TagPicker.IsOpen, Mode=TwoWay}" PlacementTarget="{Binding #AddTagButton}"
                 Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
            <ContentControl Content="{Binding TagPicker}" ContentTemplate="{StaticResource TagPickerContent}" />
          </Popup>
        </WrapPanel>
      </StackPanel>

      <!-- Personal data preview -->
      <Border DockPanel.Dock="Top" Classes="callout" Classes.warning="{Binding HasPii}" Margin="20,0,20,12" Padding="12,8" IsVisible="{Binding IsPiiPreview}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <ic:SymbolIcon Symbol="ShieldLock" />
          <StackPanel Grid.Column="1">
            <TextBlock Classes="small strong" Text="{l:Tr Editor_PiiPreviewTitle}" />
            <TextBlock Classes="small" Text="{Binding PiiSummary}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" HorizontalAlignment="Right">
            <Button Classes="subtle" Content="{l:Tr Import_Close}" Command="{Binding TogglePiiPreviewCommand}" />
            <Button Classes="accent" Content="{l:Tr Editor_ApplyMask}" Command="{Binding ApplyMaskCommand}" IsVisible="{Binding HasPii}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Unsaved edits -->
      <Border DockPanel.Dock="Top" Classes="callout" Margin="20,0,20,12" Padding="12,8" IsVisible="{Binding IsDirty}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ic:SymbolIcon Symbol="DocumentEdit" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Classes="small" Text="{l:Tr Editor_Unsaved}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
            <Button Classes="subtle" Content="{l:Tr Action_Discard}" Command="{Binding DiscardCommand}" />
            <Button x:Name="SaveButton" Classes="accent" Content="{l:Tr Action_Save}" Command="{Binding SaveCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Writing with AI failed or is not set up -->
      <Border DockPanel.Dock="Top" Classes="callout danger" Margin="20,0,20,12" Padding="12,8" IsVisible="{Binding HasAIError}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <ic:SymbolIcon Symbol="Sparkle" />
          <TextBlock x:Name="AIErrorText" Grid.Column="1" Classes="small" Text="{Binding AIError}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" HorizontalAlignment="Right">
            <Button Classes="subtle" Content="{l:Tr Import_Close}" Command="{Binding DismissAIErrorCommand}" />
            <Button Classes="accent" Content="{l:Tr Editor_AIConnections}" Command="{Binding OpenAIConnectionsCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Archived: read-only -->
      <Border DockPanel.Dock="Top" Classes="callout warning" Margin="20,0,20,12" IsVisible="{Binding IsArchived}">
        <DockPanel>
          <ic:SymbolIcon Symbol="LockClosed" />
          <TextBlock Classes="small" Text="{l:Tr Editor_ArchivedReadOnly}" />
        </DockPanel>
      </Border>

      <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" />

      <ScrollViewer>
        <StackPanel Margin="20,16,20,24" Spacing="10">
          <!-- Masked preview (read-only) -->
          <ItemsControl ItemsSource="{Binding PiiPreview}" IsVisible="{Binding IsPiiPreview}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PreviewBlock">
                <Border Classes="card" Classes.positive="{Binding IsPositive}" Classes.negative="{Binding IsNegative}" Classes.system="{Binding IsSystem}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="overline card-label" Text="{Binding Label}" />
                    <SelectableTextBlock Classes="content" Classes.muted="{Binding IsEmpty}" Text="{Binding Text}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Fields: instruction / input / output, prompt / chosen / rejected, or the system prompt of a chat -->
          <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding IsEditing}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EditorField">
                <Border Classes="card" Classes.positive="{Binding IsPositive}" Classes.negative="{Binding IsNegative}" Classes.system="{Binding IsSystem}">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="22">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ic:SymbolIcon Symbol="ThumbLike" FontSize="14" IsVisible="{Binding IsPositive}" />
                        <ic:SymbolIcon Symbol="ThumbDislike" FontSize="14" IsVisible="{Binding IsNegative}" />
                        <ic:SymbolIcon Symbol="Settings" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsSystem}" />
                        <TextBlock Classes="overline card-label" Text="{Binding Label}" />
                      </StackPanel>
                      <!-- The answer side can be written by the AI (Mod+G for the main one) -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding CanBeWritten}">
                        <TextBlock Classes="caption muted" VerticalAlignment="Center" IsVisible="{Binding IsWriting}"
                                   Text="{Binding $parent[UserControl].((vm:RecordDetailsViewModel)DataContext).WritingText}" />
                        <Button Classes="mini" ToolTip.Tip="{l:Tr Editor_Write}" IsVisible="{Binding !IsWriting}"
                                Command="{Binding $parent[UserControl].((vm:RecordDetailsViewModel)DataContext).WriteCommand}" CommandParameter="{Binding WriteTarget}">
                          <ic:SymbolIcon Symbol="Sparkle" />
                        </Button>
                        <Button Classes="mini" ToolTip.Tip="{l:Tr Editor_StopWriting}" IsVisible="{Binding IsWriting}"
                                Command="{Binding $parent[UserControl].((vm:RecordDetailsViewModel)DataContext).StopWritingCommand}">
                          <ic:SymbolIcon Symbol="Stop" IconVariant="Filled" />
                        </Button>
                      </StackPanel>
                    </Grid>
                    <controls:CodeEditor Classes="field" Text="{Binding Text}" PlaceholderText="{l:Tr Editor_Placeholder}">
                      <controls:CodeEditor.IsReadOnly>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                          <Binding Path="$parent[UserControl].((vm:RecordDetailsViewModel)DataContext).IsArchived" />
                          <Binding Path="IsWriting" />
                        </MultiBinding>
                      </controls:CodeEditor.IsReadOnly>
                    </controls:CodeEditor>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Preference pairs: what only the rejected and only the chosen answer says -->
          <Border x:Name="PreferenceCompareCard" Classes="card" IsVisible="{Binding ShowPreferenceCompare}">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="ColumnDoubleCompare" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Classes="overline card-label" Text="{l:Tr Editor_PreferenceCompare}" />
              </StackPanel>
              <TextBlock Classes="caption muted" Text="{Binding PreferenceCompareSummary}" TextWrapping="Wrap" />
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <ic:SymbolIcon Symbol="ThumbDislike" FontSize="13" Foreground="{DynamicResource NegativeBrush}" />
                  <TextBlock Classes="caption strong" Text="{l:Tr Field_Rejected}" />
                </StackPanel>
                <controls:DiffTextBlock Classes="content" Segments="{Binding RejectedSegments}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <ic:SymbolIcon Symbol="ThumbLike" FontSize="13" Foreground="{DynamicResource PositiveBrush}" />
                  <TextBlock Classes="caption strong" Text="{l:Tr Field_Chosen}" />
                </StackPanel>
                <controls:DiffTextBlock Classes="content" Segments="{Binding ChosenSegments}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Chat turns -->
          <ItemsControl ItemsSource="{Binding Messages}" IsVisible="{Binding ShowChatEditor}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EditorMessage">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="2,0"
                              HorizontalAlignment="{Binding IsUser, Converter={x:Static conv:LayoutConverters.RightIfTrue}}">
                    <ic:SymbolIcon Symbol="{Binding Role, Converter={x:Static conv:IconConverters.ChatRole}}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Classes="caption muted strong" Text="{Binding Label}" VerticalAlignment="Center" />
                    <TextBlock Classes="caption muted" VerticalAlignment="Center" IsVisible="{Binding IsWriting}"
                               Text="{Binding $parent[UserControl].((vm:RecordDetailsViewModel)DataContext).WritingText}" />
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding $parent[UserControl].((vm:RecordDetailsViewModel)DataContext).IsEditable}">
                      <Button Classes="mini" Command="{Binding SwitchRoleCommand}" ToolTip.Tip="{l:Tr Editor_SwitchRole}">
                        <ic:SymbolIcon Symbol="ArrowSwap" />
                      </Button>
                      <Button Classes="mini" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:Tr Editor_RemoveMessage}">
                        <ic:SymbolIcon Symbol="Dismiss" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                  <Border Classes="bubble" Classes.user="{Binding IsUser}" Classes.assistant="{Binding IsAssistant}"
                          HorizontalAlignment="{Binding IsUser, Converter={x:Static conv:LayoutConverters.RightIfTrue}}" MinWidth="120" MaxWidth="440">
                    <controls:CodeEditor Classes="field" Text="{Binding Text}" PlaceholderText="{l:Tr Editor_Placeholder}">
                      <controls:CodeEditor.IsReadOnly>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                          <Binding Path="$parent[UserControl].((vm:RecordDetailsViewModel)DataContext).IsArchived" />
                          <Binding Path="IsWriting" />
                        </MultiBinding>
                      </controls:CodeEditor.IsReadOnly>
                    </controls:CodeEditor>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" IsVisible="{Binding ShowChatEditor}">
            <Button Classes="subtle" Command="{Binding AddMessageCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="Add" />
                <TextBlock Text="{l:Tr Editor_AddMessage}" />
              </StackPanel>
            </Button>
            <Button x:Name="WriteReplyButton" Classes="subtle" Command="{Binding WriteCommand}" CommandParameter="{x:Static ai:AIWriteTarget.Reply}" IsVisible="{Binding !IsWriting}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="Sparkle" />
                <TextBlock Text="{l:Tr Editor_WriteReply}" />
              </StackPanel>
            </Button>
            <Button Classes="subtle" Command="{Binding StopWritingCommand}" IsVisible="{Binding IsWriting}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="Stop" IconVariant="Filled" />
                <TextBlock Text="{l:Tr Editor_StopWriting}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Quality (SDD §8) -->
          <Grid ColumnDefinitions="*,Auto" Margin="2,14,0,2">
            <TextBlock Classes="overline" Text="{l:Tr Details_Quality}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="score" Classes.good="{Binding IsQualityGood}" Classes.fair="{Binding IsQualityFair}" Classes.poor="{Binding IsQualityPoor}">
              <TextBlock Text="{Binding QualityScoreText}" />
            </Border>
          </Grid>
          <Border Classes="card" Padding="14,10">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasNoQualityIssues}">
                <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="16" Foreground="{DynamicResource PositiveBrush}" />
                <TextBlock Classes="small" Text="{l:Tr Details_NoIssues}" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding QualityIssues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:IssueItem">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                      <Panel Margin="0,1,8,0" VerticalAlignment="Top">
                        <ic:SymbolIcon Symbol="ErrorCircle" FontSize="16" Foreground="{DynamicResource DangerTextBrush}" IsVisible="{Binding IsError}" />
                        <ic:SymbolIcon Symbol="Warning" FontSize="16" Foreground="{DynamicResource WarningTextBrush}" IsVisible="{Binding IsWarning}" />
                      </Panel>
                      <TextBlock Grid.Column="1" Classes="small" Text="{Binding Text}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Info -->
          <TextBlock Classes="overline" Margin="2,14,0,2" Text="{l:Tr Details_Info}" />
          <Border Classes="card" Padding="14,10">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Info}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InfoItem">
                    <Grid ColumnDefinitions="120,*" Margin="0,3">
                      <TextBlock Classes="small muted" Text="{Binding Label}" />
                      <SelectableTextBlock Grid.Column="1" Classes="small" Classes.mono="{Binding IsMonospace}" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- The passage of the document the record was written from -->
              <StackPanel IsVisible="{Binding HasSource}" Margin="0,6,0,0" Spacing="6">
                <ToggleButton x:Name="SourceToggle" Classes="subtle small" IsChecked="{Binding IsSourceShown}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <ic:SymbolIcon Symbol="DocumentText" FontSize="14" />
                    <TextBlock Classes="small" Text="{l:Tr Editor_SourcePassage}" />
                  </StackPanel>
                </ToggleButton>
                <Border x:Name="SourcePassage" IsVisible="{Binding IsSourceShown}" Background="{DynamicResource SubtleFillBrush}" CornerRadius="6" Padding="10,8">
                  <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock Classes="small" Text="{Binding Source.Passage}" TextWrapping="Wrap" />
                  </ScrollViewer>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Several records: batch actions -->
    <StackPanel IsVisible="{Binding IsBatch}" Margin="20,18,20,20" Spacing="14">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSubtleBrush}">
          <ic:SymbolIcon Symbol="Multiselect" FontSize="20" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Classes="title" Text="{Binding BatchTitle}" VerticalAlignment="Center" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding BatchCounts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StatusCount">
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,6">
              <controls:StatusBadge Status="{Binding Status}" Text="{Binding Label}" />
              <TextBlock Classes="small muted numeric" Text="{Binding Count}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <WrapPanel Classes="actions">
        <Button Classes="accent" Command="{Binding BatchApproveCommand}" IsVisible="{Binding ShowBatchApprove}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="Checkmark" />
            <TextBlock Text="{l:Tr Action_Approve}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding BatchSendToReviewCommand}" IsVisible="{Binding ShowBatchSendToReview}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="Eye" />
            <TextBlock Text="{l:Tr Action_SendToReview}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding BatchArchiveCommand}" IsVisible="{Binding ShowBatchArchive}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="Archive" />
            <TextBlock Text="{l:Tr Action_Archive}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding BatchRestoreCommand}" IsVisible="{Binding ShowBatchRestore}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="ArrowUndo" />
            <TextBlock Text="{l:Tr Action_Restore}" />
          </StackPanel>
        </Button>
        <Button Classes="danger-subtle" Command="{Binding BatchDeleteCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="Delete" />
            <TextBlock Text="{l:Tr Action_Delete}" />
          </StackPanel>
        </Button>
      </WrapPanel>

      <!-- Tags of the selected records: × takes one off all of them -->
      <StackPanel Spacing="8">
        <TextBlock Classes="overline" Text="{l:Tr Batch_Tags}" />
        <WrapPanel>
          <ItemsControl ItemsSource="{Binding BatchTags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="tags:TagCountItem">
                <Border Classes="tag-chip" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" Fill="{Binding Tag.Color}" VerticalAlignment="Center" />
                    <TextBlock Classes="small" Text="{Binding Tag.Name}" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="small muted numeric" Text="{Binding CountText}" VerticalAlignment="Center" />
                    <Button Classes="mini" ToolTip.Tip="{l:Tr Batch_RemoveTag}" CommandParameter="{Binding Tag}"
                            Command="{Binding $parent[UserControl].((vm:RecordDetailsViewModel)DataContext).RemoveTagCommand}">
                      <ic:SymbolIcon Symbol="Dismiss" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="BatchAddTagButton" Classes="subtle small" Margin="0,0,0,6" Command="{Binding OpenBatchTagPickerCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <ic:SymbolIcon Symbol="TagAdd" FontSize="14" />
              <TextBlock Classes="small" Text="{l:Tr Batch_AddTag}" />
            </StackPanel>
          </Button>
          <Popup x:Name="BatchTagPopup" IsOpen="{Binding BatchTagPicker.IsOpen, Mode=TwoWay}" PlacementTarget="{Binding #BatchAddTagButton}"
                 Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
            <ContentControl Content="{Binding BatchTagPicker}" ContentTemplate="{StaticResource TagPickerContent}" />
          </Popup>
        </WrapPanel>
      </StackPanel>

      <TextBlock Classes="small muted" Text="{l:Tr Batch_Hint}" TextWrapping="Wrap" />
    </StackPanel>
  </Panel>
</UserControl>
