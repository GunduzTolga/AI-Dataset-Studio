<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIDatasetStudio.Desktop.ViewModels"
        xmlns:tags="using:AIDatasetStudio.Desktop.ViewModels.Tags"
        xmlns:views="using:AIDatasetStudio.Desktop.Views"
        xmlns:l="using:AIDatasetStudio.Desktop.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="860"
        x:Class="AIDatasetStudio.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="1440" Height="860"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{l:Tr Menu_File}">
        <MenuItem x:Name="NewWorkspaceMenuItem" Header="{l:Tr Menu_NewWorkspace}" Command="{Binding NewWorkspaceCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="DocumentAdd" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="OpenWorkspaceMenuItem" Header="{l:Tr Menu_OpenWorkspace}" Command="{Binding OpenWorkspaceCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="FolderOpen" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{l:Tr Menu_OpenRecent}" ItemsSource="{Binding RecentWorkspaces}" IsEnabled="{Binding HasRecentWorkspaces}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="History" /></MenuItem.Icon>
          <MenuItem.Styles>
            <Style Selector="MenuItem" x:DataType="vm:RecentWorkspaceViewModel">
              <Setter Property="Header" Value="{Binding DisplayName}" />
              <Setter Property="ToolTip.Tip" Value="{Binding FilePath}" />
              <Setter Property="Command" Value="{Binding OpenCommand}" />
              <Setter Property="CommandParameter" Value="{Binding FilePath}" />
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <MenuItem Header="{l:Tr Menu_CloseWorkspace}" Command="{Binding CloseWorkspaceCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="Dismiss" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem x:Name="ImportMenuItem" Header="{l:Tr Menu_Import}" Command="{Binding ImportCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="ArrowImport" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="ExportMenuItem" Header="{l:Tr Menu_Export}" Command="{Binding ExportCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="ArrowExport" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem x:Name="CreateVersionMenuItem" Header="{l:Tr Menu_CreateVersion}" Command="{Binding CreateVersionCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="BookmarkAdd" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="VersionsMenuItem" Header="{l:Tr Menu_Versions}" Command="{Binding VersionsCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="History" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{l:Tr Menu_Exit}" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="{l:Tr Menu_Edit}">
        <MenuItem x:Name="UndoMenuItem" Header="{Binding UndoHeader}" Command="{Binding UndoCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="ArrowUndo" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="RedoMenuItem" Header="{Binding RedoHeader}" Command="{Binding RedoCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="ArrowRedo" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem x:Name="FindMenuItem" Header="{l:Tr Menu_Find}" Click="OnFindClick" IsEnabled="{Binding Records.HasDataset}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="Search" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{l:Tr Menu_View}">
        <MenuItem Header="{l:Tr Menu_Theme}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="DarkTheme" /></MenuItem.Icon>
          <MenuItem Header="{l:Tr Theme_System}" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="System" />
          <MenuItem Header="{l:Tr Theme_Light}" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="Light" />
          <MenuItem Header="{l:Tr Theme_Dark}" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
        </MenuItem>
        <MenuItem Header="{l:Tr Menu_Language}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="LocalLanguage" /></MenuItem.Icon>
          <!-- Language names are always shown in their own language. -->
          <MenuItem Header="English" ToggleType="Radio" GroupName="language" IsChecked="{Binding IsEnglish, Mode=OneWay}"
                    Command="{Binding SetLanguageCommand}" CommandParameter="en" />
          <MenuItem Header="Türkçe" ToggleType="Radio" GroupName="language" IsChecked="{Binding IsTurkish, Mode=OneWay}"
                    Command="{Binding SetLanguageCommand}" CommandParameter="tr" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{l:Tr Menu_Record}">
        <MenuItem x:Name="SaveMenuItem" Header="{l:Tr Menu_SaveRecord}" Command="{Binding Details.SaveCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="Save" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem x:Name="ApproveNextMenuItem" Header="{l:Tr Menu_ApproveAndNext}" Command="{Binding ApproveAndNextCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="Checkmark" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="ArchiveNextMenuItem" Header="{l:Tr Menu_ArchiveAndNext}" Command="{Binding ArchiveAndNextCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="Archive" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem x:Name="NextMenuItem" Header="{l:Tr Menu_NextRecord}" Command="{Binding NextRecordCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="ArrowDown" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="PreviousMenuItem" Header="{l:Tr Menu_PreviousRecord}" Command="{Binding PreviousRecordCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="ArrowUp" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="PiiPreviewMenuItem" Header="{l:Tr Menu_PiiPreview}" Command="{Binding Details.TogglePiiPreviewCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="ShieldLock" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- Each tag toggles on the shown or selected records; those with a shortcut show Mod+N -->
        <MenuItem x:Name="TagMenuItem" Header="{l:Tr Menu_TagRecord}" ItemsSource="{Binding Tags.Tags}" IsEnabled="{Binding !Tags.IsEmpty}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="Tag" /></MenuItem.Icon>
          <MenuItem.Styles>
            <Style Selector="MenuItem" x:DataType="tags:TagViewModel">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="InputGesture" Value="{Binding Gesture}" />
              <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleTagCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
              <Setter Property="Icon">
                <Template>
                  <Ellipse Width="10" Height="10" Fill="{Binding Color}" />
                </Template>
              </Setter>
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <Separator />
        <MenuItem x:Name="DeleteMenuItem" Header="{l:Tr Menu_DeleteRecords}" Command="{Binding DeleteSelectionCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="Delete" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{l:Tr Menu_Tools}">
        <MenuItem Header="{l:Tr Menu_GenerateSampleData}" Command="{Binding GenerateSampleDataCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="Sparkle" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="CustomTermsMenuItem" Header="{l:Tr Menu_CustomTerms}" Command="{Binding EditCustomTermsCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="ShieldKeyhole" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="TagsMenuItem" Header="{l:Tr Menu_Tags}" Command="{Binding ManageTagsCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="TagMultiple" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{l:Tr Menu_Help}">
        <MenuItem x:Name="CheckForUpdatesMenuItem" Header="{l:Tr Menu_CheckForUpdates}" Command="{Binding CheckForUpdatesCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="ArrowSync" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{l:Tr Menu_CheckForUpdatesAtStartup}" ToggleType="CheckBox" IsChecked="{Binding CheckForUpdatesAtStartup}" />
        <Separator />
        <MenuItem x:Name="AboutMenuItem" Header="{l:Tr Menu_About}" Command="{Binding AboutCommand}">
          <MenuItem.Icon><ic:SymbolIcon Symbol="Info" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
    </Menu>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,5">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ic:SymbolIcon Symbol="Info" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
        <TextBlock Grid.Column="1" Classes="small secondary" Text="{Binding Status.Message}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" IsVisible="{Binding HasWorkspace}">
          <ic:SymbolIcon Symbol="DocumentText" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Classes="small muted" Text="{Binding Workspace.FilePath, FallbackValue='', TargetNullValue=''}"
                     MaxWidth="520" TextTrimming="PathSegmentEllipsis" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Panel>
      <!-- No workspace: welcome screen -->
      <views:WelcomeView IsVisible="{Binding !HasWorkspace}" />

      <!-- Workspace: sidebar | records | inspector (SDD §6.1) -->
      <Grid ColumnDefinitions="272,Auto,*,Auto,420" IsVisible="{Binding HasWorkspace}">
        <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}">
          <views:ExplorerView />
        </Border>

        <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" />

        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0">
          <views:RecordListView x:Name="RecordListView" DataContext="{Binding Records}" />
        </Border>

        <GridSplitter Grid.Column="3" Width="5" ResizeDirection="Columns" />

        <Border Grid.Column="4" Background="{DynamicResource InspectorBackgroundBrush}">
          <Panel IsVisible="{Binding Records.HasDataset}">
            <!-- Nothing selected: the dataset overview; otherwise the record editor or batch panel -->
            <views:DatasetOverviewView x:Name="OverviewView" DataContext="{Binding Overview}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Details.IsEmpty}" />
            <views:RecordDetailsView DataContext="{Binding Details}" IsVisible="{Binding !IsEmpty}" />
          </Panel>
        </Border>
      </Grid>
    </Panel>
  </DockPanel>
</Window>
