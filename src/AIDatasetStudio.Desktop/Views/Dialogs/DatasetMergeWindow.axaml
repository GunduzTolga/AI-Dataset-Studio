<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIDatasetStudio.Desktop.ViewModels.Catalog"
        xmlns:l="using:AIDatasetStudio.Desktop.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="AIDatasetStudio.Desktop.Views.Dialogs.DatasetMergeWindow"
        x:DataType="vm:DatasetMergeViewModel"
        Title="{l:Tr Merge_Title}"
        Width="820" Height="600"
        MinWidth="680" MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Padding="24,18,24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSubtleBrush}">
          <ic:SymbolIcon Symbol="Merge" FontSize="22" Foreground="{DynamicResource AccentTextBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="title" Text="{l:Tr Merge_Title}" />
          <TextBlock Classes="small muted" Text="{l:Tr Merge_Subtitle}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer -->
    <Border DockPanel.Dock="Bottom" Padding="24,12" Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="SummaryText" Classes="small muted" Text="{Binding SummaryText}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsDone}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="subtle" Content="{l:Tr Dialog_Cancel}" Command="{Binding CancelCommand}" IsCancel="True" IsVisible="{Binding !IsDone}" />
          <Button x:Name="MergeButton" Classes="accent" Command="{Binding MergeCommand}" IsVisible="{Binding !IsDone}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="Merge" />
              <TextBlock Text="{l:Tr Merge_Start}" />
            </StackPanel>
          </Button>
          <Button Classes="accent" Content="{l:Tr Import_Close}" Command="{Binding CloseCommand}" IsVisible="{Binding IsDone}"
                  MinWidth="88" HorizontalContentAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Panel>
      <!-- Choosing -->
      <Grid ColumnDefinitions="*,320" IsVisible="{Binding !IsDone}">
        <ScrollViewer x:Name="SourceList" IsEnabled="{Binding !IsMerging}">
          <StackPanel Margin="24,18,24,20" Spacing="16">
            <TextBlock Classes="overline" Text="{l:Tr Merge_SectionSources}" />
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MergeProjectGroup">
                  <StackPanel Spacing="4" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <ic:SymbolIcon Symbol="Folder" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
                      <TextBlock Classes="strong" Text="{Binding Name}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Datasets}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MergeSourceItem">
                          <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" Margin="20,2,0,2">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding Name}" />
                              <TextBlock Classes="small muted" Text="{Binding Detail}" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
          <ScrollViewer>
            <StackPanel Margin="20,18,20,20" Spacing="14">
              <TextBlock Classes="overline" Text="{l:Tr Merge_SectionTarget}" />
              <StackPanel IsEnabled="{Binding !IsMerging}">
                <TextBlock Classes="label" Text="{l:Tr Merge_Name}" />
                <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="100" />
              </StackPanel>
              <StackPanel IsEnabled="{Binding !IsMerging}">
                <TextBlock Classes="label" Text="{l:Tr Merge_Project}" />
                <ComboBox x:Name="ProjectBox" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MergeTargetOption">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Spacing="8" IsEnabled="{Binding !IsMerging}">
                <CheckBox IsChecked="{Binding SkipDuplicates}" Content="{l:Tr Merge_SkipDuplicates}" />
                <CheckBox IsChecked="{Binding IncludeArchived}" Content="{l:Tr Merge_IncludeArchived}" />
                <CheckBox IsChecked="{Binding AsDrafts}" Content="{l:Tr Merge_AsDrafts}" />
              </StackPanel>
              <TextBlock Classes="caption muted" Text="{l:Tr Merge_Hint}" TextWrapping="Wrap" />
              <StackPanel Spacing="6" IsVisible="{Binding IsMerging}">
                <ProgressBar Value="{Binding ProgressValue}" Maximum="1" />
                <TextBlock Classes="small muted" Text="{Binding ProgressText}" />
              </StackPanel>
              <Border Classes="callout danger" IsVisible="{Binding HasError}">
                <DockPanel>
                  <ic:SymbolIcon Symbol="ErrorCircle" />
                  <TextBlock Text="{Binding ErrorMessage}" />
                </DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- Done -->
      <StackPanel Classes="empty" IsVisible="{Binding IsDone}" MaxWidth="520">
        <Border Classes="empty-icon">
          <ic:SymbolIcon Symbol="CheckmarkCircle" />
        </Border>
        <TextBlock Classes="subtitle" Text="{l:Tr Merge_DoneTitle}" HorizontalAlignment="Center" />
        <TextBlock x:Name="ResultText" Classes="muted" Text="{Binding ResultText}" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Panel>
  </DockPanel>
</Window>
