<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIDatasetStudio.Desktop.ViewModels.AI"
        xmlns:l="using:AIDatasetStudio.Desktop.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="AIDatasetStudio.Desktop.Views.Dialogs.JudgeWindow"
        x:DataType="vm:JudgeViewModel"
        Title="{l:Tr Judge_Title}"
        Width="1080" Height="740"
        MinWidth="860" MinHeight="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
  <DockPanel>
    <!-- Header: the records, the dataset and the model -->
    <Border DockPanel.Dock="Top" Padding="24,18,24,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSubtleBrush}">
          <ic:SymbolIcon Symbol="Gavel" FontSize="22" Foreground="{DynamicResource AccentTextBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="title" Text="{l:Tr Judge_Title}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="TextBulletListSquare" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock x:Name="RecordsText" Classes="small strong" Text="{Binding RecordsText}" />
            <TextBlock Classes="small muted" Text="→" />
            <TextBlock Classes="small muted" Text="{Binding TargetText}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" HorizontalAlignment="Right">
          <TextBlock Classes="small muted" Text="{l:Tr QA_Model}" HorizontalAlignment="Right" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <ic:SymbolIcon Symbol="BrainCircuit" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock x:Name="ConnectionText" Classes="small" Text="{Binding ConnectionText}" />
            <Button Classes="subtle small" Content="{l:Tr Overview_AIConnections}" Command="{Binding OpenAIConnectionsCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Settings and the run -->
    <Border DockPanel.Dock="Top" Padding="24,10" Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" IsVisible="{Binding HasRecords}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <CheckBox x:Name="CompareBox" IsChecked="{Binding Compare}" Content="{l:Tr Judge_Compare}" ToolTip.Tip="{l:Tr Judge_CompareHint}"
                  IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="StartButton" Classes="accent" Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="Gavel" />
              <TextBlock Text="{l:Tr Judge_Start}" />
            </StackPanel>
          </Button>
          <Button x:Name="StopButton" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="Stop" IconVariant="Filled" />
              <TextBlock Text="{l:Tr Editor_StopWriting}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer -->
    <Border DockPanel.Dock="Bottom" Padding="24,12" Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressValue}" IsVisible="{Binding IsRunning}" MaxWidth="360" HorizontalAlignment="Left" />
          <TextBlock x:Name="ProgressText" Classes="small muted" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding ProgressText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock x:Name="SummaryText" Classes="small" Text="{Binding SummaryText}" IsVisible="{Binding HasRecords}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Classes="small muted" Text="{l:Tr Judge_Saved}" VerticalAlignment="Center" />
          <Button x:Name="CloseButton" Classes="accent" Content="{l:Tr Import_Close}" Command="{Binding CloseCommand}" IsCancel="True"
                  MinWidth="88" HorizontalContentAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The model could not judge -->
    <Border DockPanel.Dock="Top" Classes="callout danger" Margin="24,12,24,0" Padding="12,8" IsVisible="{Binding HasAIError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ic:SymbolIcon Symbol="Sparkle" VerticalAlignment="Center" />
        <TextBlock x:Name="AIErrorText" Grid.Column="1" Classes="small" Text="{Binding AIError}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
          <Button Classes="subtle" Content="{l:Tr Import_Close}" Command="{Binding DismissAIErrorCommand}" />
          <Button Classes="accent" Content="{l:Tr Editor_AIConnections}" Command="{Binding OpenAIConnectionsCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Records of this dataset cannot be judged -->
    <Border DockPanel.Dock="Top" Classes="callout warning" Margin="24,12,24,0" IsVisible="{Binding !IsSupported}">
      <DockPanel>
        <ic:SymbolIcon Symbol="Warning" />
        <TextBlock Classes="small" Text="{l:Tr Judge_Unsupported}" />
      </DockPanel>
    </Border>

    <Panel>
      <!-- Nothing to judge -->
      <StackPanel Classes="empty" IsVisible="{Binding !HasRecords}">
        <Border Classes="empty-icon">
          <ic:SymbolIcon Symbol="Gavel" />
        </Border>
        <TextBlock Classes="muted" Text="{l:Tr Judge_NoRecords}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
      </StackPanel>

      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasRecords}">
        <!-- Records -->
        <Border Width="330" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                IsVisible="{Binding HasManyRecords}">
          <DockPanel Margin="12,12,12,12">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,0,8">
              <TextBlock Classes="overline" Text="{l:Tr Variations_RecordList}" VerticalAlignment="Center" />
              <CheckBox x:Name="AllBox" Grid.Column="1" IsThreeState="True" IsChecked="{Binding AllIncluded}" Content="{l:Tr QA_All}"
                        IsEnabled="{Binding !IsRunning}" />
            </Grid>
            <ListBox x:Name="RecordList" Classes="records" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JudgeRecordViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                    <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Top" Margin="0,-2,6,0" MinWidth="0"
                              IsEnabled="{Binding !IsWriting}" ToolTip.Tip="{l:Tr Judge_Include}" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Classes="strong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="small muted numeric" Text="{Binding Number}" />
                    </StackPanel>
                    <Panel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top">
                      <Border Classes="score" Classes.good="{Binding IsGood}" Classes.fair="{Binding IsFair}" Classes.poor="{Binding IsPoor}"
                              IsVisible="{Binding IsScored}">
                        <TextBlock Classes="numeric" Text="{Binding StateText}" />
                      </Border>
                      <Border Classes="tag" Classes.warning="{Binding HasProblem}" IsVisible="{Binding ShowsStateTag}">
                        <TextBlock Text="{Binding StateText}" />
                      </Border>
                    </Panel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- The record and its judgment -->
        <ScrollViewer Grid.Column="1" IsVisible="{Binding HasSelection}">
          <StackPanel Margin="24,16,24,20" Spacing="12" DataContext="{Binding SelectedRecord}" x:DataType="vm:JudgeRecordViewModel">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock x:Name="RecordTitle" Classes="subtitle" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Classes="small muted numeric" Text="{Binding Number}" />
              </StackPanel>
              <Button x:Name="RewriteButton" Grid.Column="1" Classes="subtle" VerticalAlignment="Top"
                      Command="{Binding $parent[Window].((vm:JudgeViewModel)DataContext).RewriteCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="{l:Tr Judge_RewriteHint}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:SymbolIcon Symbol="ArrowClockwise" />
                  <TextBlock Text="{l:Tr Judge_Again}" />
                </StackPanel>
              </Button>
            </Grid>

            <TextBlock Classes="overline" Text="{l:Tr Judge_Record}" Margin="2,4,0,0" />
            <Border Classes="card" Padding="14,10">
              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{l:Tr QA_Question}" />
                <SelectableTextBlock x:Name="QuestionText" Text="{Binding Question}" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{l:Tr QA_Answer}" Margin="0,8,0,0" IsVisible="{Binding HasAnswer}" />
                <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasAnswer}">
                  <SelectableTextBlock x:Name="AnswerText" Classes="small" Text="{Binding Answer}" TextWrapping="Wrap" />
                </ScrollViewer>
              </StackPanel>
            </Border>

            <TextBlock Classes="overline" Text="{l:Tr Judge_Verdict}" Margin="2,4,0,0" />
            <Border Classes="card" Padding="14,12">
              <StackPanel Spacing="8">
                <!-- Judging now -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWriting}">
                  <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
                  <TextBlock x:Name="ActivityText" Classes="small muted" Text="{Binding Activity}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Not judged yet -->
                <TextBlock Classes="small muted" Text="{l:Tr Judge_NotJudged}" IsVisible="{Binding ShowsNoJudgment}" />
                <!-- No score in the answer -->
                <StackPanel Spacing="6" IsVisible="{Binding HasProblem}">
                  <DockPanel>
                    <ic:SymbolIcon Symbol="Warning" Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,8,0" />
                    <TextBlock Classes="small" Text="{l:Tr Judge_UnreadableHint}" TextWrapping="Wrap" />
                  </DockPanel>
                  <SelectableTextBlock Classes="small mono" Text="{Binding RawAnswer}" TextWrapping="Wrap" MaxHeight="120" />
                </StackPanel>
                <!-- The judgment -->
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasJudgment}">
                  <Border x:Name="ScorePill" Classes="score" Classes.good="{Binding IsGood}" Classes.fair="{Binding IsFair}" Classes.poor="{Binding IsPoor}"
                          VerticalAlignment="Top" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <ic:SymbolIcon Symbol="Gavel" />
                      <TextBlock Classes="numeric" Text="{Binding ScoreText}" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <SelectableTextBlock x:Name="ReasonText" Text="{Binding Reason}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Notes}" IsVisible="{Binding HasNotes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                            <ic:SymbolIcon Symbol="Warning" FontSize="16" Foreground="{DynamicResource WarningTextBrush}" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Classes="small" Text="{Binding}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="small muted" Text="{l:Tr Judge_Outdated}" IsVisible="{Binding IsOutdated}" TextWrapping="Wrap" />
                    <TextBlock Classes="caption muted" Text="{Binding Info}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Panel>
  </DockPanel>
</Window>
