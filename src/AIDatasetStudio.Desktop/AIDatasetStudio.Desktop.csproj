<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AIDatasetStudio</AssemblyName>
    <RootNamespace>AIDatasetStudio.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- English is the neutral language; Turkish ships as a satellite assembly. -->
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Strongly typed accessor generated at build time (no designer file to keep in sync). -->
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>AIDatasetStudio.Desktop.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.g.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Window icon; app.icns and app.png are used by the macOS and Linux packages (see build/). -->
    <AvaloniaResource Include="Assets\app.ico" />
    <!-- Syntax definitions of the record editor, loaded by CodeHighlighting. -->
    <EmbeddedResource Include="Highlighting\*.xshd" LogicalName="Highlighting.%(Filename).xshd" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AIDatasetStudio.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIDatasetStudio.Application\AIDatasetStudio.Application.csproj" />
    <ProjectReference Include="..\AIDatasetStudio.Infrastructure\AIDatasetStudio.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentIcons.Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

</Project>
